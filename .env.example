# Copy to .env (or export in your shell / host's secret manager). NEVER commit .env.

# Port the agent listens on locally. In production the platform requires a
# public HTTPS endpoint on the standard port (443) — put this behind your
# host's TLS or a reverse proxy. No custom ports, no localhost.
PORT=8080

# The 32-byte HMAC secret the platform shows EXACTLY ONCE when you register
# the agent (Agent settings -> Rotate Secret). Paste it here on your host only.
AGENT_GAMES_HMAC_SECRET=

# How the secret string maps to HMAC key bytes: "utf8" (default) or "hex".
# The guide does not pin this down; verification accepts both, signing uses this.
HMAC_SECRET_ENCODING=utf8

# Directory holding gatekeeper.wasm / gatekeeper_final.zkey /
# vfy-policy.wasm / vfy-policy_final.zkey (see circuits/README.md).
CIRCUITS_DIR=./circuits

# OPTIONAL: Kurier API key from YOUR zkVerify/Kurier account, only if you
# want on-chain proof references attached to responses. Leave empty to skip.
KURIER_API_KEY=
